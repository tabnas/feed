{
  "$schema": "https://tabnas.dev/schema/plugin.schema.json",
  "name": "@tabnas/feed",
  "go": "github.com/tabnas/feed/go",
  "description": "RSS (0.90 to 2.0) and Atom (0.3, 1.0) feed parsing for the tabnas engine, normalized to an Atom shape.",
  "engine": "@tabnas/parser",
  "extensions": [
    ".rss",
    ".atom"
  ],
  "specDir": "test/spec",
  "clib": {
    "dir": "go/clib",
    "library": "libtabnasfeed",
    "abi": "v1",
    "errorCodes": [
      "usage",
      "grammar",
      "handle",
      "internal"
    ]
  },
  "errorCodes": [],
  "docs": "https://tabnas.dev/docs/packages",
  "repository": "https://github.com/tabnas/feed",
  "versionSource": "ts/package.json"
}
